# ===========================================
# Aquaponics Server Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# For Docker deployment, variables are read from the root .env file.

# --- База данных ---
POSTGRES_USER=aquaponics_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aquaponics_db

# --- Авторизация (JWT) ---
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=24h

# --- MQTT брокер ---
MQTT_HOST=mqtt://localhost:1883
MQTT_USERNAME=device
MQTT_PASSWORD=CHANGE_ME

# --- Порты ---
FRONTEND_PORT=80
BACKEND_PORT=3000
DB_PORT=5432
MQTT_PORT=1883
MQTT_WS_PORT=9001

# --- Server ---
PORT=3000
NODE_ENV=development

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# --- Email уведомления (SMTP) — опционально ---
# Заполните, чтобы включить email-оповещения о выходе за пороги.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=465
# EMAIL_USER=your_email@example.com
# EMAIL_PASS=your_app_password

