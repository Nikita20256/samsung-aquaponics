# ===========================================
# Aquaponics — Конфигурация
# ===========================================
# Этот файл создаётся автоматически при первом запуске.
# Вы можете отредактировать его вручную и перезапустить:
#   docker compose restart
# ===========================================

# --- База данных ---
POSTGRES_USER=aquaponics_app
POSTGRES_PASSWORD=aserver
POSTGRES_DB=aquaponics_db

# --- Авторизация (JWT) ---
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=24h

# --- MQTT брокер ---
MQTT_HOST=mqtt://localhost:1883
MQTT_USERNAME=device
MQTT_PASSWORD=device_password

# --- Порты ---
FRONTEND_PORT=80
BACKEND_PORT=3000
DB_PORT=5432
MQTT_PORT=1883
MQTT_WS_PORT=9001

# --- CORS (для доступа извне) ---
# Если разворачиваете на VPS или используете доступ по IP/домену:
# Добавьте ваш домен/IP через запятую.
# Пример: http://localhost,http://my-domain.com,http://192.168.1.50
CORS_ORIGINS=http://localhost,http://localhost:80
