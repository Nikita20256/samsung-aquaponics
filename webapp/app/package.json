{
  "name": "app",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel ngrok",
    "mobile:tunnel": "node scripts/start-mobile-tunnel.cjs",
    "mobile:qr": "node scripts/prepare-mobile-connection.cjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:api": "node --test scripts/test-api.cjs",
    "test:server": "node scripts/test-server.cjs"
  },
  "dependencies": {
    "expo": "~58.0.19",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-secure-store": "~58.0.2",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "react-dom": "19.3.0",
    "react-native-web": "~0.21.4",
    "typescript": "~6.0.3"
  }
}
